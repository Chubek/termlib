@alias Global :G
@alias Runtime :R
@alias Puppeteer :PUP
@alias Recorder :REC

@define $ENVELOPE $E
@define $TERMINAL $TERM
@define $CONFIGURATION $CNF

.interface
    R:Declare:Section(:Interface)
    R:Declare:Section(:Prelude)
    R:Declare:Section(:Config)
    R:Declare:Section(:Data)
    R:Declare:Section(:Argparse)
    R:Declare:Section(:Program)
.end


.section Interface

    G:Declare:Namespace(:Services)
    G:Declare:Namespace(:Tapes)

    G:Declare:Symbol(:Puppeteer)
    G:Declare:Symbol(:Recorder)
    G:Declare:Symbol(:Grammar)

    G:Declare:Symbol(:Allocator)
    G:Declare:Symbol(:Deallocator)
    G:Declare:Symbol(:Terminal)
    G:Declare:Symbol(:JSONReader)

.end


.section Prelude

    lifetime Puppeteer := G:Import("std.puppeteer")
        ~> R:ImportError(
            "Import Error: ~s, ~e",
            $E->Libname,
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        => R:Inject $E->Library, G:Puppeteer
        ;

    lifetime Recorder := G:Import("std.recorder")
        ~> R:ImportError(
            "Import Error: ~s, ~e",
            $E->Libname,
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        => R:Inject $E->Library, G:Recorder
        ;

    lifetime Grammar := G:Import("std.libglr")
        ~> R:ImportError(
            "Import Error: ~s, ~e",
            $E->Libname,
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        => Services:SetupCLIParser($E->ConstructRecipe)
        ;

.end


.section Config

    config Allocator :=
        Tapes:Load("stdlib.qmalloc.allocate");

    config Deallocator :=
        Tapes:Load("stdlib.qmalloc.deallocate");

    config Terminal :=
        $TERM->CurrentTTY();

    config JSONReader :=
        Tapes:Load("stdlib.serde.JSONReader");

.end


.section Data

    lifetime Session := PUP:CreateSession(
        :TERMINAL
    )
        ~> R:RuntimeError(
            "Puppeteer initialization failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    lifetime Tape := REC:CreateTape()
        ~> R:RuntimeError(
            "Recorder initialization failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    config Envelope := {
        "program": $CNF->ProgramName,
        "version": $CNF->Version,
        "terminal": $TERM->CurrentTTY(),
        "recording": true
    };

.end


.section Argparse

    $ArgParse := Services:CreateCLIParser();

    $ArgParse:DeclareOption(
        "--help",
        "-h",
        :BOOLEAN,
        "Display usage information"
    );

    $ArgParse:DeclareOption(
        "--version",
        "-v",
        :BOOLEAN,
        "Display program version"
    );

    $ArgParse:DeclareOption(
        "--config",
        "-c",
        :STRING,
        "Load a configuration file"
    );

    $ArgParse:DeclareOption(
        "--record",
        "-r",
        :BOOLEAN,
        "Record terminal interactions"
    );

    $ArgParse:DeclareOption(
        "--replay",
        :STRING,
        "Replay a recorded terminal session"
    );

    $ArgParse:DeclareOption(
        "--backend",
        "-b",
        :STRING,
        "Select the execution backend: c, vm, or qbe"
    );

    $ArgParse:ValidateOption(
        "--backend",
        ["c", "vm", "qbe"]
    );

    $ArgParse:Parse(G:ARGV);

.end


.section Program

    G:OnStartup(:Prelude);
    G:OnStartup(:Config);
    G:OnStartup(:Data);
    G:OnStartup(:Argparse);

    if $ArgParse->Has("--help") then
        Services:PrintUsage($ArgParse);
        R:Exit(:EXIT_SUCCESS);
    end

    if $ArgParse->Has("--version") then
        R:Print("%s\n", $CNF->Version);
        R:Exit(:EXIT_SUCCESS);
    end

    if $ArgParse->Has("--config") then
        $CNF := JSONReader:Read(
            $ArgParse->Get("--config")
        )
            ~> R:ConfigurationError(
                "Configuration error: ~s",
                $E->Msg
            )
            -> R:DieGracefully(:EXIT_FAILURE)
            ;
    end

    if $ArgParse->Has("--replay") then
        REC:Replay(
            $ArgParse->Get("--replay"),
            Session
        )
            ~> R:RuntimeError(
                "Replay failed: ~s",
                $E->Msg
            )
            -> R:DieGracefully(:EXIT_FAILURE)
            ;

        R:Exit(:EXIT_SUCCESS);
    end

    if $ArgParse->Has("--record") then
        REC:Begin(Tape);
    end

    PUP:Run(Session)
        ~> R:RuntimeError(
            "Terminal execution failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    if $ArgParse->Has("--record") then
        REC:Save(Tape);
    end

    PUP:DestroySession(Session);

    R:Exit(:EXIT_SUCCESS);

.end
``````text
@alias Global :G
@alias Runtime :R
@alias Puppeteer :PUP
@alias Recorder :REC

@define $ENVELOPE $E
@define $TERMINAL $TERM
@define $CONFIGURATION $CNF

.interface
    R:Declare:Section(:Interface)
    R:Declare:Section(:Prelude)
    R:Declare:Section(:Config)
    R:Declare:Section(:Data)
    R:Declare:Section(:Argparse)
    R:Declare:Section(:Program)
.end


.section Interface

    G:Declare:Namespace(:Services)
    G:Declare:Namespace(:Tapes)

    G:Declare:Symbol(:Puppeteer)
    G:Declare:Symbol(:Recorder)
    G:Declare:Symbol(:Grammar)

    G:Declare:Symbol(:Allocator)
    G:Declare:Symbol(:Deallocator)
    G:Declare:Symbol(:Terminal)
    G:Declare:Symbol(:JSONReader)

.end


.section Prelude

    lifetime Puppeteer := G:Import("std.puppeteer")
        ~> R:ImportError(
            "Import Error: ~s, ~e",
            $E->Libname,
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        => R:Inject $E->Library, G:Puppeteer
        ;

    lifetime Recorder := G:Import("std.recorder")
        ~> R:ImportError(
            "Import Error: ~s, ~e",
            $E->Libname,
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        => R:Inject $E->Library, G:Recorder
        ;

    lifetime Grammar := G:Import("std.libglr")
        ~> R:ImportError(
            "Import Error: ~s, ~e",
            $E->Libname,
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        => Services:SetupCLIParser($E->ConstructRecipe)
        ;

.end


.section Config

    config Allocator :=
        Tapes:Load("stdlib.qmalloc.allocate");

    config Deallocator :=
        Tapes:Load("stdlib.qmalloc.deallocate");

    config Terminal :=
        $TERM->CurrentTTY();

    config JSONReader :=
        Tapes:Load("stdlib.serde.JSONReader");

.end


.section Data

    lifetime Session := PUP:CreateSession(
        :TERMINAL
    )
        ~> R:RuntimeError(
            "Puppeteer initialization failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    lifetime Tape := REC:CreateTape()
        ~> R:RuntimeError(
            "Recorder initialization failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    config Envelope := {
        "program": $CNF->ProgramName,
        "version": $CNF->Version,
        "terminal": $TERM->CurrentTTY(),
        "recording": true
    };

.end


.section Argparse

    $ArgParse := Services:CreateCLIParser();

    $ArgParse:DeclareOption(
        "--help",
        "-h",
        :BOOLEAN,
        "Display usage information"
    );

    $ArgParse:DeclareOption(
        "--version",
        "-v",
        :BOOLEAN,
        "Display program version"
    );

    $ArgParse:DeclareOption(
        "--config",
        "-c",
        :STRING,
        "Load a configuration file"
    );

    $ArgParse:DeclareOption(
        "--record",
        "-r",
        :BOOLEAN,
        "Record terminal interactions"
    );

    $ArgParse:DeclareOption(
        "--replay",
        :STRING,
        "Replay a recorded terminal session"
    );

    $ArgParse:DeclareOption(
        "--backend",
        "-b",
        :STRING,
        "Select the execution backend: c, vm, or qbe"
    );

    $ArgParse:ValidateOption(
        "--backend",
        ["c", "vm", "qbe"]
    );

    $ArgParse:Parse(G:ARGV);

.end


.section Program

    G:OnStartup(:Prelude);
    G:OnStartup(:Config);
    G:OnStartup(:Data);
    G:OnStartup(:Argparse);

    if $ArgParse->Has("--help") then
        Services:PrintUsage($ArgParse);
        R:Exit(:EXIT_SUCCESS);
    end

    if $ArgParse->Has("--version") then
        R:Print("%s\n", $CNF->Version);
        R:Exit(:EXIT_SUCCESS);
    end

    if $ArgParse->Has("--config") then
        $CNF := JSONReader:Read(
            $ArgParse->Get("--config")
        )
            ~> R:ConfigurationError(
                "Configuration error: ~s",
                $E->Msg
            )
            -> R:DieGracefully(:EXIT_FAILURE)
            ;
    end

    if $ArgParse->Hash("--puppeteer-script") then
	scope raeder = 
		G:ShebangLoader($ArgParse->Get("--puppeteer-script"));
	REC:RunScript(reader);
	R:CleanupAndeExit(:EXIT_SUCCESS);
    end

    if $ArgParse->Has("--replay") then
        REC:Replay(
            $ArgParse->Get("--replay"),
            Session
        )
            ~> R:RuntimeError(
                "Replay failed: ~s",
                $E->Msg
            )
            -> R:DieGracefully(:EXIT_FAILURE)
            ;

        R:Exit(:EXIT_SUCCESS);
    end

    if $ArgParse->Has("--record") then
        REC:Begin(Tape);
    end

    PUP:Run(Session)
        ~> R:RuntimeError(
            "Terminal execution failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    if $ArgParse->Has("--record") then
        REC:Save(Tape);
    end

    PUP:DestroySession(Session);

    R:Exit(:EXIT_SUCCESS);

.end
