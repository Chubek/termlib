
@alias Global :G
@alias Runtime :R
@alias CRDT :CRDT
@alias SSH :SSH
@alias Console :IC
@alias Services :SVC

@define $ENVELOPE $E
@define $CONFIGURATION $CNF
@define $WORKSPACE $WS
@define $SESSION $SES

.interface
    R:Declare:Section(:Interface)
    R:Declare:Section(:Prelude)
    R:Declare:Section(:Config)
    R:Declare:Section(:Data)
    R:Declare:Section(:Argparse)
    R:Declare:Section(:Program)
.end


.section Interface

    G:Declare:Namespace(:Services)

    G:Declare:Symbol(:CRDT)
    G:Declare:Symbol(:SSH)
    G:Declare:Symbol(:Console)

    G:Declare:Symbol(:Workspace)
    G:Declare:Symbol(:Session)
    G:Declare:Symbol(:SharedDocument)

.end


.section Prelude

    lifetime CRDT := G:Import("std.crdt")
        ~> R:ImportError(
            "CRDT Import Error: ~s, ~e",
            $E->Libname,
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        => R:Inject $E->Library, G:CRDT
        ;

    lifetime SSH := G:Import("std.ssh")
        ~> R:ImportError(
            "SSH Import Error: ~s, ~e",
            $E->Libname,
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        => R:Inject $E->Library, G:SSH
        ;

    lifetime Console := G:Import("std.isocline")
        ~> R:ImportError(
            "Console Import Error: ~s, ~e",
            $E->Libname,
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        => R:Inject $E->Library, G:Console
        ;

.end


.section Config

    config Transport := :SSH;
    config MergeStrategy := :CRDT;
    config DefaultRole := :EDITOR;

    config WorkspaceConfig := {
        "private": true,
        "verify_host_key": true,
        "authentication": "public-key",
        "merge_strategy": "crdt",
        "allow_remote_commands": false
    };

.end


.section Data

    lifetime Workspace := CRDT:CreateWorkspace()
        ~> R:RuntimeError(
            "Workspace initialization failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    lifetime SharedDocument := CRDT:CreateDocument(
        Workspace
    )
        ~> R:RuntimeError(
            "Shared document initialization failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    lifetime Session := SSH:CreateSession()
        ~> R:RuntimeError(
            "SSH session initialization failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

.end


.section Argparse

    $ArgParse := Services:CreateCLIParser();

    $ArgParse:DeclareOption(
        "--host",
        "-H",
        :STRING,
        "Remote collaboration host"
    );

    $ArgParse:DeclareOption(
        "--user",
        "-u",
        :STRING,
        "Remote account name"
    );

    $ArgParse:DeclareOption(
        "--project",
        "-p",
        :STRING,
        "Project directory"
    );

    $ArgParse:DeclareOption(
        "--join",
        "-j",
        :STRING,
        "Join an existing collaboration workspace"
    );

    $ArgParse:DeclareOption(
        "--role",
        :STRING,
        "Participant role: editor or viewer"
    );

    $ArgParse:DeclareOption(
        "--history",
        :BOOLEAN,
        "Show recent workspace activity"
    );

    $ArgParse:DeclareOption(
        "--help",
        "-h",
        :BOOLEAN,
        "Display usage information"
    );

    $ArgParse:ValidateOption(
        "--role",
        ["editor", "viewer"]
    );

    $ArgParse:Parse(G:ARGV);

.end


.section Program

    G:OnStartup(:Prelude);
    G:OnStartup(:Config);
    G:OnStartup(:Data);
    G:OnStartup(:Argparse);

    if $ArgParse->Has("--help") then
        Services:PrintUsage($ArgParse);
        R:Exit(:EXIT_SUCCESS);
    end

    if not $ArgParse->Has("--host") then
        R:PrintError("A remote host is required.\n");
        R:Exit(:EXIT_FAILURE);
    end

    if not $ArgParse->Has("--user") then
        R:PrintError("A remote account is required.\n");
        R:Exit(:EXIT_FAILURE);
    end

    SSH:SetHostKeyVerification(
        Session,
        true
    );

    SSH:Connect(
        Session,
        $ArgParse->Get("--host"),
        $ArgParse->Get("--user")
    )
        ~> R:ConnectionError(
            "SSH connection failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    SSH:AuthenticatePublicKey(Session)
        ~> R:AuthenticationError(
            "SSH authentication failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    $WS := CRDT:JoinWorkspace(
        Session,
        $ArgParse->GetOr("--join", "default")
    )
        ~> R:RuntimeError(
            "Unable to join workspace: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    CRDT:SetParticipantRole(
        $WS,
        $ArgParse->GetOr("--role", "editor")
    )
        ~> R:PermissionError(
            "Unable to set participant role: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    if $ArgParse->Has("--project") then
        Services:OpenProject(
            $WS,
            $ArgParse->Get("--project")
        )
            ~> R:IOError(
                "Unable to open project: ~s",
                $E->Msg
            )
            -> R:DieGracefully(:EXIT_FAILURE)
            ;
    end

    CRDT:Synchronize(
        $WS,
        SharedDocument,
        :MergeStrategy
    )
        ~> R:RuntimeError(
            "Initial synchronization failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    if $ArgParse->Has("--history") then
        CRDT:PrintHistory($WS);
    end

    IC:Initialize();

    IC:SetPrompt("teamcode> ");

    CRDT:OnRemoteEdit(
        $WS,
        Services:RenderRemoteEdit
    );

    CRDT:OnConflict(
        $WS,
        Services:ReportMergeConflict
    );

    SSH:OnDisconnect(
        Session,
        Services:HandleDisconnect
    );

    Services:RunTeamCodeREPL(
        IC,
        $WS,
        SharedDocument
    )
        ~> R:RuntimeError(
            "Collaboration session failed: ~s",
            $E->Msg
        )
        -> R:DieGracefully(:EXIT_FAILURE)
        ;

    CRDT:Synchronize(
        $WS,
        SharedDocument,
        :MergeStrategy
    );

    CRDT:LeaveWorkspace($WS);

    SSH:Disconnect(Session);

    IC:Shutdown();

    R:Exit(:EXIT_SUCCESS);

.end
