(profile
  (version 1)
  (name "Python")
  (extension ".py")
  (backend python)
  (template "# Generated by NovoParse.
import json as _json
from NovoParse import Parser as RuntimeParser

SPEC = _json.loads({{tables}})

class {{name}}Parser(RuntimeParser):
    def __init__(self, library=None):
        super().__init__(SPEC, library=library)

def parse(text, library=None):
    with {{name}}Parser(library=library) as parser:
        return parser.parse(text)
"))
