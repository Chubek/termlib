(profile
  (version 1)
  (name "C++")
  (extension ".hpp")
  (backend c)
  (template "// Generated by NovoParse.
#ifndef NP_GENERATED_{{name}}_HPP
#define NP_GENERATED_{{name}}_HPP
#include <NovoParse.hpp>
{{tables}}
class {{name}}Parser : public novoparse::Parser {
public:
    {{name}}Parser() : novoparse::Parser({{name}}_grammar) {}
};
#endif
"))
