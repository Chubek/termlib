(profile
  (version 1)
  (name "C")
  (extension ".h")
  (backend c)
  (template "/* Generated by NovoParse. */
#ifndef NP_GENERATED_{{name}}_H
#define NP_GENERATED_{{name}}_H
#include <NovoParse.h>
{{tables}}
static inline np_parser *{{name}}_create(char *error, size_t size)
{
    return np_parser_create(&{{name}}_grammar, error, size);
}
#endif
"))
