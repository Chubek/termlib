file(MAKE_DIRECTORY "${WORK}")
set(source "${WORK}/entry.tsc")
file(WRITE "${source}" "use list\nfn main(args: [str]) -> int { print(list.len(args)); return 7 }\n")
execute_process(COMMAND "${DRIVER}" "${source}" "a b" "--flag"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 7 OR NOT output STREQUAL "2\n")
  message(FATAL_ERROR "VM entry (${status}): ${output} ${error}")
endif()
execute_process(COMMAND "${DRIVER}" - "a b" "--flag" INPUT_FILE "${source}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT status EQUAL 7 OR NOT output STREQUAL "2\n")
  message(FATAL_ERROR "stdin entry (${status}): ${output} ${error}")
endif()
set(backends c)
if(NATIVE)
  list(APPEND backends qbe)
endif()
foreach(backend IN LISTS backends)
  execute_process(COMMAND "${DRIVER}" --backend "${backend}" -o "${WORK}/entry-${backend}" "${source}"
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${backend} compile: ${error}")
  endif()
  execute_process(COMMAND "${WORK}/entry-${backend}" "a b" "--flag"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 7 OR NOT output STREQUAL "2\n")
    message(FATAL_ERROR "${backend} entry (${status}): ${output} ${error}")
  endif()
endforeach()
if(JITERATI)
  execute_process(COMMAND "${DRIVER}" --backend jiterati "${source}" "a b" "--flag"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 7 OR NOT output STREQUAL "2\n")
    message(FATAL_ERROR "JIT entry (${status}): ${output} ${error}")
  endif()
endif()
