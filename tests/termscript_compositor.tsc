G:import "compositor";
G:import "emulator";
const L = G:load "std.list";
const c = compositor_m:new 32 32;
const s = compositor_m:surface c 32 32;
compositor_m:fill s 4294901760;
compositor_m:commit s;
compositor_m:present c;
const f = compositor_m:frame c;
const pixel = L:get f 0;
G:puts pixel;
const em = emulator_m:new c 2 4;
emulator_m:feed em "OK";
emulator_m:render em;
compositor_m:present c;
const text = emulator_m:text em;
G:puts text;
emulator_m:close em;
compositor_m:close c;
G:puts "compositor and emulator OK";
