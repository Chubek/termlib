G:import "utf8";
G:import "cell";
G:import "bidi";
G:import "stylesheet";
G:import "html";
G:import "prompt_string";
G:import "tui";
G:import "screen";
G:import "vterm";
G:import "layout";
G:import "baudrate";
G:import "termios";
G:import "terminal";
G:import "font_discovery";
const C = cell_m;
const U = utf8_m;
const T = tui_m;
const S = screen_m;
const V = vterm_m;
const CSS = stylesheet_m;
const H = html_m;
const c = C:new "界" "#123456" "default" 5;
const cwidth = C:width c;
G:puts cwidth;
const text_width = U:width "سلام é 👩‍💻";
G:puts text_width;
const visual = bidi_m:visual "سلام دنیا";
G:puts visual;
const app = T:new 3 14;
T:box app 0 0 3 14 "فارسی";
T:put_visual app 1 2 "سلام";
const frame = T:render app;
const emulator = V:new 3 14;
V:feed emulator frame;
const plain = V:text emulator;
G:puts plain;
const doc = H:parse "<div class='panel'><b>سلام</b> world &amp; TUI</div>";
const sheet = CSS:parse ".panel {color: #123456; font-style: italic} b {color: rgb(255,0,0); font-weight: bold}";
CSS:apply sheet doc;
const node = H:query doc "b";
const style = CSS:style node;
const foreground = C:foreground style;
G:puts foreground;
const rendered = H:render doc 40;
const rendered_width = U:width rendered;
G:puts rendered_width;
const prompt = prompt_string_m:expand "${basename} $$ ";
const supported = baudrate_m:supported 9600;
G:puts supported;
const fitted = layout_m:align "界" 5 "center";
G:puts fitted;
G:puts "terminal stdlib OK";
