# Import every companion through VM, C, QBE and the available JIT adapter.
file(MAKE_DIRECTORY "${WORK}")
file(GLOB companions "${STDLIB}/*/*.tsc")
set(source "")
foreach(companion IN LISTS companions)
  # Syntax/lowering check also covers the display/device-dependent examples.
  execute_process(COMMAND "${DRIVER}" -c -o "${WORK}/syntax.c" "${companion}"
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Companion/example syntax (${companion}): ${error}")
  endif()
  get_filename_component(name "${companion}" NAME_WE)
  get_filename_component(dir "${companion}" DIRECTORY)
  get_filename_component(dir "${dir}" NAME)
  if(name STREQUAL dir)
    string(APPEND source "G:import(\"${name}\");\n")
  endif()
endforeach()
string(APPEND source "G:puts(\"all stdlib companions OK\");\n")
set(SOURCE "${WORK}/companions.tsc")
file(WRITE "${SOURCE}" "${source}")
set(MARKER "all stdlib companions OK")
include("${CMAKE_CURRENT_LIST_DIR}/termscript_backends.cmake")
if(JITERATI)
  execute_process(COMMAND "${DRIVER}" --backend jiterati "${SOURCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE jit ERROR_VARIABLE error)
  if(NOT status EQUAL 0 OR NOT vm STREQUAL jit)
    message(FATAL_ERROR "Jiterati companion mismatch (${status}): ${error}\n${jit}")
  endif()
endif()
