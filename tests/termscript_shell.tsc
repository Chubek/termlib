G:import "shell";
G:import "list";
G:import "json";
const SH = shell_m;
const sh = SH:new;
SH:set sh "LABEL" "hello world";
const label = SH:word "\"$LABEL\"";
const command = SH:command "printf" "[%s]\n" label;
const text = SH:capture sh command;
G:puts text;
const consumer = SH:parse "tr a-z A-Z";
const pipeline = SH:pipeline command consumer;
const output = SH:capture sh pipeline;
G:puts output;
const report = SH:result sh;
const code = json_m:get report "code";
G:puts code;
const failure = SH:parse "false";
const recovery = SH:sequence failure command "or";
const recovered = SH:capture sh recovery;
G:puts recovered;
const fields = SH:expand sh "$LABEL";
const count = list_m:len fields;
G:puts count;
SH:close sh;
G:puts "shell stdlib OK";
