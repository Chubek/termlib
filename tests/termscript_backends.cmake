file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${DRIVER}" "${SOURCE}" RESULT_VARIABLE status OUTPUT_VARIABLE vm ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "VM: ${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "TMPDIR=${WORK}"
  "${DRIVER}" -o "${WORK}/program with 'quote'" "${SOURCE}" RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "AOT compile/link: ${error}")
endif()
execute_process(COMMAND "${WORK}/program with 'quote'" RESULT_VARIABLE status OUTPUT_VARIABLE aot ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "AOT run: ${error}")
endif()
if(NOT vm STREQUAL aot)
  message(FATAL_ERROR "Backend mismatch:\nVM: ${vm}\nAOT: ${aot}")
endif()
if(NATIVE)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "TMPDIR=${WORK}"
    "${DRIVER}" --backend qbe -o "${WORK}/native program" "${SOURCE}"
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "QBE/Keystone compile: ${error}")
  endif()
  execute_process(COMMAND "${WORK}/native program" RESULT_VARIABLE status
    OUTPUT_VARIABLE native ERROR_VARIABLE error)
  if(NOT status EQUAL 0 OR NOT vm STREQUAL native)
    message(FATAL_ERROR "Native mismatch (${status}): ${error}\nVM: ${vm}\nNative: ${native}")
  endif()
endif()
if(JITERATI)
  execute_process(COMMAND "${DRIVER}" --backend jiterati "${SOURCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE jit ERROR_VARIABLE error)
  if(NOT status EQUAL 0 OR NOT vm STREQUAL jit)
    message(FATAL_ERROR "Jiterati mismatch (${status}): ${error}\nVM: ${vm}\nJIT: ${jit}")
  endif()
endif()
if(NOT DEFINED MARKER)
  set(MARKER "terminal stdlib OK")
endif()
if(NOT vm MATCHES "${MARKER}")
  message(FATAL_ERROR "Missing integration success marker: ${vm}")
endif()
