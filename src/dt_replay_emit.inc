/* Private replay source emitters. Included after crecord/text-buffer helpers.
 */
static const char dt_replay_js_clock[]
    = "const bytes = e => Uint8Array.from(e.data, c => c.charCodeAt(0));\n"
      "async function play({onEvent = () => {}, speed = 1,\n"
      "  sleep = ms => new Promise(r => setTimeout(r, ms)),\n"
      "  now = () => performance.now()} = {}) {\n"
      "  if (!Number.isFinite(speed) || speed <= 0) throw new "
      "RangeError('invalid replay speed');\n"
      "  if (!events.length) return;\n"
      "  const start = now(), first = events[0].t;\n"
      "  let elapsed = 0n;\n"
      "  for (const e of events) {\n"
      "    const relative = e.t > first ? e.t - first : 0n;\n"
      "    if (relative > elapsed) elapsed = relative;\n"
      "    const target = Number(elapsed) / 1e6 / speed;\n"
      "    for (;;) {\n"
      "      const left = target - (now() - start);\n"
      "      if (left <= 0) break;\n"
      "      await sleep(Math.min(left, 2147483647));\n"
      "    }\n"
      "    await onEvent(e, bytes(e));\n"
      "  }\n"
      "}\n";

static void
dt_replay_js_events (crecord *recs, size_t count, char **body, size_t *len,
                     size_t *cap)
{
  dt_buf_str (body, len, cap, "// Generated by Termlib\nconst events = [\n");
  for (size_t i = 0; i < count; i++)
    {
      char line[192];
      snprintf (line, sizeof line,
                "{t:%llun,type:%d,rows:%u,columns:%u,data:\"",
                (unsigned long long)recs[i].ts, (int)recs[i].type,
                recs[i].rows, recs[i].columns);
      dt_buf_str (body, len, cap, line);
      dt_buf_escaped (body, len, cap, recs[i].data, recs[i].len, "\\x%02x");
      dt_buf_str (body, len, cap, "\"},\n");
    }
  dt_buf_str (body, len, cap, "];\n");
}

static bool
dt_emit_replay (crecord *recs, size_t count, DT_ReplayerTarget target,
                char **body, size_t *len, size_t *cap)
{
  if (target == DT_CCTARGET_JS || target == DT_CCTARGET_WEBGPU
      || target == DT_CCTARGET_PROCESSING)
    dt_replay_js_events (recs, count, body, len, cap);
  switch (target)
    {
    case DT_CCTARGET_TERMSCRIPT:
      dt_buf_str (body, len, cap,
                  "# Generated by Termlib: output bytes only, unpaced.\n"
                  "const replay_stdio = G:load(\"std.stdio\");\n");
      for (size_t i = 0; i < count; i++)
        {
          if (recs[i].type != DT_RECORD_OUTPUT)
            continue;
          for (size_t pos = 0; pos < recs[i].len; pos += 4096)
            {
              size_t n = recs[i].len - pos;
              if (n > 4096)
                n = 4096;
              dt_buf_str (body, len, cap, "replay_stdio:write_hex(\"");
              dt_buf_escaped (body, len, cap, recs[i].data + pos, n, "%02x");
              dt_buf_str (body, len, cap, "\");\n");
            }
        }
      dt_buf_str (body, len, cap, "replay_stdio:flush();\n");
      break;
    case DT_CCTARGET_JS:
      dt_buf_str (body, len, cap, dt_replay_js_clock);
      dt_buf_str (
          body, len, cap,
          "const replay = play;\n"
          "if (typeof module === 'object' && module.exports) {\n"
          "  module.exports = {events, replay};\n"
          "  if (require.main === module) replay({onEvent: (e, data) => {\n"
          "    if (e.type === 2) process.stdout.write(data);\n"
          "  }}).catch(e => { console.error(e); process.exitCode = 1; });\n"
          "} else globalThis.TermlibReplay = {events, replay};\n");
      break;
    case DT_CCTARGET_WASM:
      {
        size_t total = 0, offset = 0;
        char line[256];
        for (size_t i = 0; i < count; i++)
          total += recs[i].len;
        size_t pages = (total + 65535) / 65536;
        if (!pages)
          pages = 1;
        snprintf (line, sizeof line,
                  ";; Generated by Termlib: host schedules event timestamps.\n"
                  "(module\n"
                  " (import \"termlib\" \"event\" (func $event (param i32 i64 "
                  "i32 i32 i32 i32)))\n"
                  " (memory (export \"memory\") %zu)\n",
                  pages);
        dt_buf_str (body, len, cap, line);
        for (size_t i = 0; i < count; i++)
          {
            if (recs[i].len)
              {
                snprintf (line, sizeof line, " (data (i32.const %zu) \"",
                          offset);
                dt_buf_str (body, len, cap, line);
                dt_buf_escaped (body, len, cap, recs[i].data, recs[i].len,
                                "\\%02x");
                dt_buf_str (body, len, cap, "\")\n");
              }
            offset += recs[i].len;
          }
        dt_buf_str (body, len, cap, " (func (export \"replay\")\n");
        offset = 0;
        for (size_t i = 0; i < count; i++)
          {
            snprintf (line, sizeof line,
                      "  (call $event (i32.const %d) (i64.const %llu) "
                      "(i32.const %zu) (i32.const %zu) (i32.const %u) "
                      "(i32.const %u))\n",
                      (int)recs[i].type, (unsigned long long)recs[i].ts,
                      offset, recs[i].len, recs[i].rows, recs[i].columns);
            dt_buf_str (body, len, cap, line);
            offset += recs[i].len;
          }
        dt_buf_str (body, len, cap, " )\n)\n");
      }
      break;
    case DT_CCTARGET_WEBGPU:
      dt_buf_str (body, len, cap, dt_replay_js_clock);
      dt_buf_str (
          body, len, cap,
          "async function replay(device, onBuffer, options = {}) {\n"
          "  if (!device || typeof onBuffer !== 'function')\n"
          "    throw new TypeError('GPU device and buffer consumer "
          "required');\n"
          "  return play({...options, onEvent: async (e, data) => {\n"
          "    if (options.onEvent) await options.onEvent(e, data);\n"
          "    if (e.type !== 2) return;\n"
          "    const size = Math.max(4, Math.ceil(data.length / 4) * 4);\n"
          "    if (size > device.limits.maxBufferSize ||\n"
          "        size > device.limits.maxStorageBufferBindingSize)\n"
          "      throw new RangeError('replay event exceeds GPU buffer "
          "limit');\n"
          "    const buffer = device.createBuffer({size,\n"
          "      usage: GPUBufferUsage.COPY_DST | GPUBufferUsage.STORAGE});\n"
          "    try {\n"
          "      const padded = new Uint8Array(size); padded.set(data);\n"
          "      device.queue.writeBuffer(buffer, 0, padded);\n"
          "      await onBuffer(buffer, e, data.length);\n"
          "    } finally {\n"
          "      try { await device.queue.onSubmittedWorkDone(); }\n"
          "      finally { buffer.destroy(); }\n"
          "    }\n"
          "  }});\n"
          "}\n"
          "if (typeof module === 'object' && module.exports)\n"
          "  module.exports = {events, replay};\n"
          "else globalThis.TermlibReplay = {events, replay};\n");
      break;
    case DT_CCTARGET_MANIM:
      dt_buf_str (
          body, len, cap,
          "# Generated by Termlib: UTF-8 text preview, not a terminal "
          "emulator.\n"
          "import codecs\nfrom manim import Scene, Text\n\nevents = [\n");
      for (size_t i = 0; i < count; i++)
        {
          char line[192];
          /* Emit separately to keep all recorded data out of Python syntax. */
          snprintf (line, sizeof line, "(%llu, %d, %u, %u, bytes.fromhex('",
                    (unsigned long long)recs[i].ts, (int)recs[i].type,
                    recs[i].rows, recs[i].columns);
          dt_buf_str (body, len, cap, line);
          dt_buf_escaped (body, len, cap, recs[i].data, recs[i].len, "%02x");
          dt_buf_str (body, len, cap, "')),\n");
        }
      dt_buf_str (
          body, len, cap,
          "]\n\nclass Replay(Scene):\n"
          "    def construct(self):\n"
          "        decoder = "
          "codecs.getincrementaldecoder('utf-8')('replace')\n"
          "        rendered, screen, elapsed = '', None, 0\n"
          "        first = events[0][0] if events else 0\n"
          "        for timestamp, kind, rows, columns, data in events:\n"
          "            target = max(elapsed, timestamp - first, 0)\n"
          "            if target > elapsed: self.wait((target - elapsed) / "
          "1e9)\n"
          "            elapsed = target\n"
          "            if kind == 2:\n"
          "                rendered = (rendered + "
          "decoder.decode(data))[-65536:]\n"
          "                visible = ''.join(c if c.isprintable() or c in "
          "'\\n\\t' else '\\ufffd' for c in rendered)\n"
          "                if screen is not None: self.remove(screen)\n"
          "                screen = Text(visible or ' ')\n"
          "                self.add(screen)\n"
          "        tail = decoder.decode(b'', final=True)\n"
          "        if tail:\n"
          "            if screen is not None: self.remove(screen)\n"
          "            self.add(Text((rendered + tail)[-65536:] or ' '))\n");
      break;
    case DT_CCTARGET_PROCESSING:
      dt_buf_str (
          body, len, cap,
          "// p5.js UTF-8 text preview; no ANSI cursor emulation.\n"
          "const bytes = e => Uint8Array.from(e.data, c => c.charCodeAt(0));\n"
          "const decoder = new TextDecoder('utf-8');\n"
          "let replayIndex = 0, replayStart = 0, replayText = '';\n"
          "function setup() {\n"
          "  createCanvas(640, 480); textFont('monospace'); textSize(14);\n"
          "  replayStart = millis();\n"
          "}\n"
          "function draw() {\n"
          "  while (replayIndex < events.length) {\n"
          "    const e = events[replayIndex], first = events[0].t;\n"
          "    const due = Number(e.t > first ? e.t - first : 0n) / 1e6;\n"
          "    if (due > millis() - replayStart) break;\n"
          "    replayIndex++;\n"
          "    if (e.type === 2) replayText = (replayText +\n"
          "      decoder.decode(bytes(e), {stream:true})).slice(-65536);\n"
          "    if (e.type === 3) resizeCanvas(\n"
          "      Math.min(4096, Math.max(1, e.columns) * 8 + 16),\n"
          "      Math.min(4096, Math.max(1, e.rows) * 16 + 16));\n"
          "  }\n"
          "  if (replayIndex === events.length) {\n"
          "    replayText = (replayText + decoder.decode()).slice(-65536); "
          "noLoop();\n"
          "  }\n"
          "  background(0); fill(255);\n"
          "  text(replayText.replace(/[\\x00-\\x08\\x0b-\\x1f\\x7f]/g, "
          "'\\ufffd'),\n"
          "       8, 8, width - 16, height - 16);\n"
          "}\n");
      break;
    default:
      return false;
    }
  return *cap != SIZE_MAX && *len <= DT_REPLAY_MAX_SOURCE;
}
